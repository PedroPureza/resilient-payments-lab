# Copie este arquivo para .env e ajuste se necessário.
# .env nunca é commitado (ver .gitignore).

# --- Postgres ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_PORT=5432
DATABASE_URL=postgres://payments:payments@localhost:5432/payments

# --- RabbitMQ ---
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://payments:payments@localhost:5672

# --- API ---
PORT=3000
LOG_LEVEL=info

# --- Simulação de falhas (worker, usado a partir da Fase 5) ---
FAILURE_RATE=0
IDEMPOTENCY_ENABLED=true
