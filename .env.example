# --- Postgres ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_PORT=5432
DATABASE_URL=postgres://payments:payments@localhost:5432/payments

# --- RabbitMQ ---
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://payments:payments@localhost:5672

# --- API ---
PORT=3000
LOG_LEVEL=info

# --- Idempotência e outbox (API) ---
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_LOCK_TIMEOUT_MS=30000
IDEMPOTENCY_KEY_TTL_MS=86400000
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_MIN_AGE_MS=5000

# --- Simulação de falhas e retry (worker) ---
FAILURE_RATE=0
FAILURE_MODES=exception,timeout,unavailable
CHAOS_TIMEOUT_MS=300
MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=1000
WORKER_PREFETCH=10
